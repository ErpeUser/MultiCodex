# Never publish local user state, OAuth secrets, or copied sessions
.codex/
CodexProfiles/
ClaudeProfiles/
**/auth.json
**/openai-codex-accounts.json
**/api-routes.json
**/local-client-tokens.json
**/usage_cache.json
**/Cookies
**/Cookies-journal
*.wal
*.lock
!requirements-build.windows-x64.lock
.env
.env.*
!.env.example
# Centralized generated data: preserve generated/project as versioned source.
/generated/runtime/
/generated/local/

# Legacy fallback ignores if a tool accidentally writes outside generated/.
# Build and dependencies
node_modules/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
build/
dist/
output/
*.spec.bak
.venv/
*.egg-info/
# local runtime
*.log
*.tmp
.DS_Store
# Recovery scratch and real runtime state never belong in commits
.superpowers/
profiles/
.sessions/
*.bundle
release-acceptance.local.json
# CI evidence is uploaded explicitly, not committed as generated source
evidence/
# Workspace-provided tooling and old local probe outputs
.agents/
runtime-check.json
gui-check.json
